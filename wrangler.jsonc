{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spieltisch",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Alles außer /api/* liefert die React-App aus
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "SETTINGS", "class_name": "SiteSettings" },
      { "name": "PROFILES", "class_name": "ProfileStore" },
      { "name": "GROUPS", "class_name": "GroupStore" }
    ]
  },
  // Im kostenlosen Tarif sind nur SQLite-basierte Durable Objects erlaubt
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["SiteSettings"] },
    { "tag": "v3", "new_sqlite_classes": ["ProfileStore"] },
    { "tag": "v4", "new_sqlite_classes": ["GroupStore"] }
  ],
  "observability": { "enabled": true },
  // Eigene Domain (DNS-Eintrag und Zertifikat legt Cloudflare selbst an). Die workers.dev-Adresse bleibt erreichbar:
  // Profile und Geräteschlüssel liegen im Browser je Adresse – wer dort spielt, zieht per Übertragungs-Code um.
  "routes": [{ "pattern": "spieltisch.endlab.de", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // Nicht geheim und deshalb hier statt im Dashboard: dort gesetzte Variablen löscht jeder Deploy.
  // Das Gegenstück REALTIME_APP_TOKEN bleibt ein Secret (wrangler secret put).
  // CF_ACCOUNT_ID und WORKER_NAME braucht das Freischalten wartender Updates (mit dem Secret DEPLOY_TOKEN).
  // UPDATE_MODE hier setzen, um den Update-Zeitpunkt aus dem Admin zu überschreiben (now, round, idle, time, manual).
  "vars": { "REALTIME_APP_ID": "6a2b13fa601e8f01bf6a94ccf63620bf", "CF_ACCOUNT_ID": "ef9cbceacd8be6cff839033e54c0cb6b", "WORKER_NAME": "spieltisch" },
  // Globale Ratenbremse für sicherheitsrelevante Wege (Profil-Schlüssel, Übertragungs-Code) – je Adresse und Minute
  "ratelimits": [{ "name": "SENSITIVE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // Größere Dateien (Fotos der Spieler) – Namen sind nicht erratbar, Räume räumen ihre Fotos beim Ende selbst weg
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "spieltisch-dateien" }],
  "ai": { "binding": "AI" },
  // Alle 5 Minuten prüfen, ob ein wartendes Update live gehen darf
  "triggers": { "crons": ["*/5 * * * *"] },
  // Vorschau je Zweig (Cloudflare Worker Previews, nur für Nicht-main-Zweige):
  // Jede Vorschau bekommt eigene, leere Durable Objects – Räume, Einstellungen, Profile und Gruppen von live bleiben unberührt.
  // Secrets erbt sie nicht: ohne ADMIN_PASSWORD ist die Verwaltung dort aus, ohne Realtime-Token auch Audio und Video.
  "previews": {
    // Gleicher Speicher wie live: jeder Raum legt unter seiner eigenen Objekt-ID ab, Vorschau-Räume haben eigene IDs
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "spieltisch-dateien" }],
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "GameRoom" },
        { "name": "SETTINGS", "class_name": "SiteSettings" },
        { "name": "PROFILES", "class_name": "ProfileStore" },
        { "name": "GROUPS", "class_name": "GroupStore" }
      ]
    }
  }
}
